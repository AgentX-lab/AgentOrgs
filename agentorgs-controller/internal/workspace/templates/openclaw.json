{
  "gateway": {
    "mode": "local",
    "auth": {
      "token": "agentorgs-local"
    },
    "remote": {
      "token": "agentorgs-local"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/workspace",
      "model": {
        "primary": "gpt-4o-mini"
      }
    }
  },
  "channels": {
    "matrix": {
      "enabled": false,
      "homeserver": "",
      "userId": "",
      "accessToken": "",
      "network": {
        "dangerouslyAllowPrivateNetwork": true
      }
    }
  },
  "plugins": {
    "load": {
      "paths": ["/opt/openclaw/extensions/matrix"]
    },
    "entries": {
      "matrix": { "enabled": true }
    }
  }
}
